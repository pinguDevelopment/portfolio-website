# Kopiere diese Datei zu ".env" und fuelle die Werte aus. ".env" NIEMALS committen!

NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# Generiere mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Discord Developer Portal -> New Application -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://deinedomain.de/auth/discord/callback
DISCORD_SCOPES=identify guilds

# Redis fuer persistente Sessions (empfohlen fuer Produktion). Leer lassen -> MemoryStore (nur lokal testen)
REDIS_URL=redis://redis:6379
